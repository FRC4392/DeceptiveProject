# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output and generated caches
dist
dist-ssr
.vite
coverage
*.tsbuildinfo

# Local environment files
.env
.env.*
# Last on purpose: a later `.env*` line would undo this and silently ignore
# any new example file.
!.env*.example
*.local

# Package manager output
.npm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel's per-checkout project link
.vercel

# Claude Code's per-machine scaffolding — launch.json names a dev server by
# local port, so it belongs to a checkout rather than to the project.
.claude/
