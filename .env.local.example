# Copy this file to .env.local and fill in the values for your machine.
# .env.local is generated/updated automatically by `npx convex dev` the
# first time you run it against a deployment, so most of this is already
# handled for you.

# Which Convex deployment `npx convex dev` / `npx convex deploy` targets.
CONVEX_DEPLOYMENT=

# The Convex client URL used by the frontend to connect to your deployment.
VITE_CONVEX_URL=

# The Convex HTTP/site URL used in admin setup links for OAuth callbacks,
# Onshape panels, and GitHub webhooks.
VITE_CONVEX_SITE_URL=

# --- WorkOS AuthKit (frontend, safe to expose to the browser) ---
# Your existing WorkOS Client ID (starts with "client_").
VITE_WORKOS_CLIENT_ID=
# Where WorkOS redirects back to after sign-in. Must be registered as a
# Redirect URI in the WorkOS dashboard. Defaults to your app's origin.
VITE_WORKOS_REDIRECT_URI=http://localhost:5173

# --- WorkOS AuthKit (backend secrets) ---
# These are NOT read from this file or any local .env — they live only in
# the Convex deployment's environment, set via:
#
#   npx convex env set WORKOS_CLIENT_ID <your existing client id>
#   npx convex env set WORKOS_API_KEY <your existing api key>
#   npx convex env set WORKOS_WEBHOOK_SECRET <secret from the webhook you create>
#
# Reuse the WORKOS_CLIENT_ID / WORKOS_API_KEY from your existing WorkOS
# team/dashboard so users and sessions are shared across apps. Do not let
# any tooling auto-provision a new WorkOS team.
#
# Note: WORKOS_COOKIE_PASSWORD is used by server-rendered WorkOS AuthKit
# integrations (e.g. @workos-inc/authkit-nextjs) that seal session data
# into a cookie. This app is a client-side SPA using
# @workos-inc/authkit-react + Convex's customJwt auth, which validates
# WorkOS-issued JWTs directly and never creates a sealed cookie session,
# so WORKOS_COOKIE_PASSWORD is not used here.
#
# This app uses WorkOS user ids as cross-app roster keys, matching
# DeceptiveHours. If this shared WorkOS environment ever rejects otherwise-valid
# tokens because of a multi-app issuer mismatch, mirror the
# WORKOS_ENVIRONMENT_CLIENT_ID auth.config.ts pattern from DeceptiveHours.

# --- Onshape OAuth sync (Phase 3; backend secrets, Convex env only) ---
# Like the WorkOS secrets, these live only in the Convex deployment
# environment, not in this file. Set them via:
#
#   npx convex env set ONSHAPE_OAUTH_CLIENT_ID <your Onshape OAuth app client id>
#   npx convex env set ONSHAPE_OAUTH_CLIENT_SECRET <your Onshape OAuth app client secret>
#   npx convex env set ONSHAPE_SYNC_SECRET <random string>
#   npx convex env set ONSHAPE_TOKEN_ENC_KEY <output of `openssl rand -base64 32`>
#   npx convex env set ONSHAPE_BASE_URL <optional alternate Onshape base URL>
#
# ONSHAPE_OAUTH_CLIENT_ID/SECRET authorize the one-time team OAuth connection
# (Admin → Onshape → Connect). ONSHAPE_SYNC_SECRET guards the right-panel/
# extension sync endpoints. ONSHAPE_TOKEN_ENC_KEY is the AES-256 key (32
# bytes, base64) used to encrypt the stored access/refresh tokens at rest
# (convex/lib/tokenCrypto.ts) — losing it just means reconnecting via OAuth
# again, since it isn't used for anything else.
# ONSHAPE_BASE_URL is optional and defaults to https://cad.onshape.com.
#
# Convex also exposes CONVEX_SITE_URL to backend functions for the deployment's
# HTTP endpoint. Keep VITE_CONVEX_SITE_URL in this file in sync with that site
# URL so frontend setup links point at the same deployment.

# --- GitHub issue sync (Phase 4; backend secrets, Convex env only) ---
# Like the WorkOS/Onshape secrets, these live only in the Convex deployment
# environment, not in this file. Set them via:
#
#   npx convex env set GITHUB_WEBHOOK_SECRET <random string>
#   npx convex env set GITHUB_TOKEN <a GitHub PAT with repo/issues scope>
#
# GITHUB_WEBHOOK_SECRET verifies the HMAC signature on the repo webhook
# (payload URL: https://<your-deployment>.convex.site/github/webhook,
# events: Issues, Issue comments, Pull requests). GITHUB_TOKEN authorizes
# the "Import a repository" action and write-back (close / comment on GitHub).
# Configure both from Admin → GitHub in the app.
